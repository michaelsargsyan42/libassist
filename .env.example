# Copy to .env, edit, then load it into your shell:  set -a && . ./.env && set +a
# Nothing here is required for `make test` or `make demo`.

# --- REST API (libassist-api)
LIBASSIST_DB_PATH=./libassist.db
LIBASSIST_HOST=127.0.0.1
LIBASSIST_PORT=8000
# Fixed business date. The demo data (due dates, overdue loans) is relative to it.
LIBASSIST_TODAY=2026-03-02

# --- MCP server (libassist-mcp): where to find the REST API
LIBASSIST_API_URL=http://127.0.0.1:8000
LIBASSIST_LOG_LEVEL=WARNING

# --- LLM: any OpenAI-compatible /chat/completions endpoint with tool calling.
# Needed only for libassist-chat and evals/run_evals.py. Local and free with Ollama:
#   ollama pull qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# --- Optional: real embeddings for RAG (otherwise a built-in hashing embedder is used)
#   ollama pull nomic-embed-text
# EMBEDDINGS_BASE_URL=http://localhost:11434/v1
# EMBEDDINGS_MODEL=nomic-embed-text
# EMBEDDINGS_API_KEY=
